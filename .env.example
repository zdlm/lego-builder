# LEGO Builder uses your Claude subscription through the Claude Code CLI — no API key.
# Install Claude Code and sign in once with your Claude account: run `claude` and log in.
# Do NOT set ANTHROPIC_API_KEY; the pipeline strips it anyway so usage stays on your subscription.

# Path to the Claude Code CLI (default: `claude` on your PATH)
LEGO_BUILDER_CLAUDE_BIN=claude
# Optional model alias passed to `claude --model` (e.g. sonnet, opus). Empty = CLI default.
LEGO_BUILDER_MODEL=
# Seconds to wait for one Claude call
LEGO_BUILDER_CLAUDE_TIMEOUT_S=300
# Where input PDFs and run outputs live
LEGO_BUILDER_DATA_DIR=data
# DPI used when rasterising PDF pages
LEGO_BUILDER_PDF_DPI=200
