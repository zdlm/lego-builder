# LEGO Builder calls the LLM through GitHub Copilot CLI on your own Copilot plan — no API key.
# Install it (`brew install --cask copilot-cli` or `npm install -g @github/copilot`), run `copilot`
# once and `/login`. Headless alternative: export COPILOT_GITHUB_TOKEN (fine-grained PAT with the
# "Copilot Requests" permission) in your shell — never commit it.

# Which CLI to use: copilot (default) or claude (Claude Code on a Claude subscription)
LEGO_BUILDER_LLM=copilot
# Path to the Copilot CLI (default: `copilot` on your PATH)
LEGO_BUILDER_COPILOT_BIN=copilot
# Path to the Claude Code CLI, only used when LEGO_BUILDER_LLM=claude
LEGO_BUILDER_CLAUDE_BIN=claude
# Optional model passed as --model (must support images), e.g. claude-sonnet-5.5. Empty = CLI default.
LEGO_BUILDER_MODEL=
# Seconds to wait for one LLM call
LEGO_BUILDER_LLM_TIMEOUT_S=300
# Reuse validated replies for identical prompt + images (data/cache/llm)
LEGO_BUILDER_LLM_CACHE=true
# Where input PDFs and run outputs live
LEGO_BUILDER_DATA_DIR=data
# DPI used when rasterising PDF pages
LEGO_BUILDER_PDF_DPI=200
